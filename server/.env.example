# Postgres connection string
DATABASE_URL=postgres://quiz:quiz@localhost:5432/quiz
# Required in production: at least 32 random characters (e.g. `openssl rand -hex 32`)
JWT_SECRET=
# Enables the question admin at /admin when set. Use a long random value.
ADMIN_TOKEN=
# Comma-separated list of allowed browser origins, only needed if the web app is hosted on another domain
CORS_ORIGIN=
PORT=3000
